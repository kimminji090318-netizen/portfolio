<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>중3 역사 무한 문제풀기</title>
    <style>
        :root {
            --bg: #f4f6f8;
            --card: #ffffff;
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --success: #16a34a;
            --border: #e5e7eb;
            --text: #1f2937;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg);
            color: var(--text);
            margin: 0;
            padding: 12px;
            display: flex;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 680px;
            background: var(--card);
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 20px;
            box-sizing: border-box;
        }

        header {
            text-align: center;
            border-bottom: 2px solid var(--border);
            padding-bottom: 12px;
            margin-bottom: 20px;
        }

        h1 {
            font-size: 1.25rem;
            margin: 0 0 6px 0;
            color: #111827;
        }

        .sub-title {
            font-size: 0.85rem;
            color: #6b7280;
            font-weight: bold;
        }

        .loading-screen {
            text-align: center;
            padding: 50px 20px;
        }

        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid var(--primary);
            border-radius: 50%;
            width: 40px;
            height: 40px;
            animation: spin 0.9s linear infinite;
            margin: 0 auto 16px auto;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .q-card {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 20px;
            background: #ffffff;
        }

        .q-tag {
            display: inline-block;
            font-size: 0.8rem;
            font-weight: bold;
            color: var(--primary);
            background: #eff6ff;
            padding: 3px 8px;
            border-radius: 4px;
            margin-bottom: 8px;
        }

        .q-title {
            font-size: 1.05rem;
            font-weight: 700;
            line-height: 1.5;
            margin-bottom: 14px;
            word-break: keep-all;
        }

        .options {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .option-label {
            display: flex;
            align-items: flex-start;
            padding: 10px 12px;
            border: 1px solid var(--border);
            border-radius: 6px;
            cursor: pointer;
            transition: background 0.15s;
            font-size: 0.95rem;
            line-height: 1.4;
        }

        .option-label:hover {
            background-color: #f9fafb;
        }

        .option-label input {
            margin-right: 10px;
            margin-top: 3px;
        }

        textarea.essay-input {
            width: 100%;
            height: 85px;
            padding: 10px;
            border: 1px solid var(--border);
            border-radius: 6px;
            box-sizing: border-box;
            font-size: 0.95rem;
            resize: vertical;
        }

        .explanation {
            margin-top: 12px;
            padding: 12px;
            background-color: #f8fafc;
            border-left: 4px solid var(--primary);
            font-size: 0.9rem;
            display: none;
            line-height: 1.5;
        }

        .btn {
            width: 100%;
            padding: 14px;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
        }

        .btn:hover {
            background-color: var(--primary-dark);
        }

        .btn-reload {
            background-color: var(--success);
            margin-top: 15px;
        }

        .result-summary {
            text-align: center;
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 20px;
            padding: 15px;
            background: #f1f5f9;
            border-radius: 8px;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>중3 역사 중간고사 무한 문제풀기</h1>
        <div class="sub-title">고려-몽골 전쟁 ~ 조선 전기 (25개 고유 주제 · 무작위 정답 셔플)</div>
    </header>

    <div id="loading" class="loading-screen">
        <div class="spinner"></div>
        <p>정답 번호 및 보기를 무작위 섞어 정밀 검증 중입니다...</p>
    </div>

    <form id="quiz-form" style="display: none;">
        <div id="quiz-list"></div>
        <button type="button" class="btn" onclick="gradeQuiz()">답안 제출 및 채점하기</button>
    </form>

    <div id="result-area" style="display: none;">
        <div class="result-summary" id="result-summary"></div>
        <button type="button" class="btn btn-reload" onclick="generateNewQuiz()">🔄 완전 새로운 문제 세트 생성하기</button>
    </div>
</div>

<script>
    // =========================================================
    // 🔑 API Key 설정 (아래 큰따옴표 안에 Gemini API Key를 붙여넣으세요)
    // =========================================================
    const DEFAULT_GEMINI_API_KEY = "ENETER YOUR AI API KEY.";

    // 25개 고유 주제 1대1 매핑 데이터 (중복 방지용)
    const topics = [
        { id: 1, topic: "고려-몽골 전쟁 원인 및 저고여 사건" },
        { id: 2, topic: "처인성 전투 (용인, 김윤후, 처인부곡민)" },
        { id: 3, topic: "고려-몽골 강화 조건 (고려 왕조 및 풍속 유지)" },
        { id: 4, topic: "원의 영토 기구 (쌍성총관부, 동녕부, 탐라총관부)" },
        { id: 5, topic: "원 간섭기 관제 격하 및 몽골풍 유행" },
        { id: 6, topic: "권문세족의 농장 소유와 수탈" },
        { id: 7, topic: "공민왕의 전민변정도감과 신돈의 개혁" },
        { id: 8, topic: "신진사대부의 성리학 수용과 분파 (정몽주, 정도전)" },
        { id: 9, topic: "신흥 무인 세력의 성장 (최영, 이성계)" },
        { id: 10, topic: "고려 말~조선 최고의 교육기관 (성균관)" },
        { id: 11, topic: "고려 시대 남녀 균등 상속과 가족제도" },
        { id: 12, topic: "고려의 향도 조직과 노동 공동체" },
        { id: 13, topic: "팔만대장경판 (합천 해인사, 세계기록유산)" },
        { id: 14, topic: "직지심체요절 (1377년 금속활자)" },
        { id: 15, topic: "조선 한양의 유교적 배치 (경복궁, 종묘, 사직단 등)" },
        { id: 16, topic: "조선의 국호 의미 (고조선 계승)" },
        { id: 17, topic: "조선의 명에 대한 사대 외교 목적" },
        { id: 18, topic: "조선 세종의 집현전과 경연 (왕권과 신권의 조화)" },
        { id: 19, topic: "조선 태종의 업적 (사병 혁파, 호패법)" },
        { id: 20, topic: "조선 세조의 업적 (6조 직계제, 경국대전 착수)" },
        { id: 21, topic: "조선 성종의 업적 (경국대전 완성, 홍문관)" },
        { id: 22, topic: "조선의 지방 행정 조직 (8도, 관찰사, 수령, 향리, 유향소)" },
        { id: 23, topic: "조선의 과거 제도 (문과, 무과, 잡과, 식년시)" },
        { id: 24, topic: "조선 중앙 정치 기구 (의정부 3정승)" },
        { id: 25, topic: "조선 세종 대 쓰시마섬(대마도) 정벌 및 교린 관계" }
    ];

    let generatedQuizData = [];

    // 피셔-예이츠 셔플 알고리즘
    function shuffleArray(array) {
        const arr = [...array];
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
        return arr;
    }

    // 객관식 보기 셔플 및 정답 인덱스 재계산 함수
    function shuffleOptionsAndFixAnswer(questionObj) {
        if (questionObj.type !== 'choice' || !Array.isArray(questionObj.options)) return questionObj;

        const originalCorrectOptionText = questionObj.options[questionObj.answer];
        const shuffledOptions = shuffleArray(questionObj.options);
        const newCorrectAnswerIndex = shuffledOptions.indexOf(originalCorrectOptionText);

        return {
            ...questionObj,
            options: shuffledOptions,
            answer: newCorrectAnswerIndex
        };
    }

    async function generateNewQuiz() {
        document.getElementById('loading').style.display = 'block';
        document.getElementById('quiz-form').style.display = 'none';
        document.getElementById('result-area').style.display = 'none';

        const apiKey = DEFAULT_GEMINI_API_KEY.trim();

        if (apiKey && !apiKey.includes("여기에_발급받으신")) {
            try {
                generatedQuizData = await fetchQuizFromGemini(apiKey);
            } catch (e) {
                console.error("API 호출 중 오류 발생, 백업 문제 엔진 작동:", e);
                generatedQuizData = generateLocalFallbackQuiz();
            }
        } else {
            generatedQuizData = generateLocalFallbackQuiz();
        }

        renderQuiz();
        document.getElementById('loading').style.display = 'none';
        document.getElementById('quiz-form').style.display = 'block';
    }

    async function fetchQuizFromGemini(key) {
        const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${key}`;

        const prompt = `
당신은 중학교 3학년 한국사 시험 출제 교사입니다.
제시된 25개 고유 주제 목록을 바탕으로 중3 역사 시험 25문제를 출제하십시오.

[출제 가이드라인 - 엄격 준수]
1. 아래 25개 주제를 1번부터 25번까지 1:1로 정확히 대응시켜 총 25문제를 만드시오. (문제 간 내용 중복 금지!)
   - 1번~22번: 객관식 5지선다형 (options 배열에 정확히 5개 역사 선택지)
   - 23번~25번: 서술형 (options 없음, type: "essay")
2. **정답 위치 필수 무작위화**: 정답 번호(answer 인덱스 0~4)가 특정 번호에 쏠리지 않고 0, 1, 2, 3, 4 번 위치에 골고루 무작위로 배치되도록 선택지 순서를 구성하십시오.
3. **보기(options) 작성 엄격 제한**:
   - 보기는 오직 순수한 역사적 명칭, 사실, 문장으로만 구성하십시오.
   - 보기 안에 "(O)", "(X)", "틀린 설명", "오답 이유", "정답 해설" 같은 부가 설명 문구를 **절대로 넣지 마십시오.**
   - 보기 및 문제 텍스트에 영어 알파벳(A~Z), "Q1", "Q28", "범위", "출처" 문구를 **절대로 넣지 마십시오.**
4. 정답 설명은 오직 "explanation" 필드에만 작성하십시오.

[25개 출제 주제]
${JSON.stringify(topics, null, 2)}

[반환 형식: JSON 배열만 출력]
[
  {
    "type": "choice",
    "question": "1번 주제 관련 문제 텍스트",
    "options": ["선택지1", "선택지2", "선택지3", "선택지4", "선택지5"],
    "answer": 2,
    "explanation": "해설 텍스트"
  },
  ... (22개 객관식)
  {
    "type": "essay",
    "question": "서술형 문제 텍스트",
    "answer": "모범 답안 텍스트",
    "explanation": "서술형 채점 기준 및 해설"
  }
]
`;

        const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                contents: [{ parts: [{ text: prompt }] }]
            })
        });

        const data = await response.json();
        let text = data.candidates[0].content.parts[0].text;
        text = text.replace(/```json/g, '').replace(/```/g, '').trim();

        const rawList = JSON.parse(text);

        // 텍스트 정제 및 정답 번호 무작위 2차 셔플
        return rawList.map(q => {
            q.question = cleanText(q.question);
            if (q.type === 'choice' && Array.isArray(q.options)) {
                q.options = q.options.map(opt => cleanText(opt));
                return shuffleOptionsAndFixAnswer(q);
            }
            return q;
        });
    }

    // 강력한 텍스트 세척 함수 (영어, 오답설명, 범위표시 등 제거)
    function cleanText(str) {
        if (!str) return "";
        return str
            .replace(/[a-zA-Z]/g, '')                     // 영문 알파벳 제거
            .replace(/Q\d+/g, '')                          // Q1, Q28 등 출처표기 제거
            .replace(/범위|출처|순서/g, '')                 // 메타 단어 제거
            .replace(/\(O\)|\(X\)|\(오답\)|\(정답\)/g, '')   // (O), (X) 표시 제거
            .replace(/오답인 이유:?.*$/g, '')              // 보기 내 오답설명 문구 제거
            .replace(/^[\d\.\s\-\)]+/, '')                 // 앞쪽 중복 번호 제거
            .trim();
    }

    function generateLocalFallbackQuiz() {
        const rawQuiz = [
            { type: "choice", question: "고려 시대 몽골이 고려를 침략하게 된 직접적인 구실이 된 사건은?", options: ["저고여 살해 사건", "강강술래 유행", "삼별초의 항쟁", "묘청의 난", "신돈의 개혁"], answer: 0, explanation: "몽골 사신 저고여가 고려에서 돌아가는 길에 살해된 사건을 구실로 침략했습니다." },
            { type: "choice", question: "고려-몽골 전쟁 중 김윤후와 부곡민들이 몽골 장수 살리타를 처단한 전투 지역은?", options: ["경기도 용인 처인성", "강화도", "서경 평양성", "제주도", "철령 이북"], answer: 0, explanation: "김윤후는 처인성 전투에서 몽골 장수 살리타를 사살했습니다." },
            { type: "choice", question: "고려가 몽골과 강화를 맺을 때 쿠빌라이로부터 약속받은 내용으로 옳은 것은?", options: ["고려의 고유한 제도와 풍속 유지", "고려 왕실의 완벽한 폐지", "고려 영토 전체의 원나라 직속령화", "성균관의 철거", "삼별초의 해산"], answer: 0, explanation: "몽골은 고려의 왕조를 유지하고 고유 풍속(불금지제)을 인정했습니다." },
            { type: "choice", question: "원나라가 고려의 철령 이북 영토를 직접 지배하기 위해 설치했던 기구는?", options: ["쌍성총관부", "동녕부", "탐라총관부", "정동행성", "교정도감"], answer: 0, explanation: "철령 이북에는 쌍성총관부, 서경에는 동녕부, 제주에는 탐라총관부가 설치되었습니다." },
            { type: "choice", question: "원 간섭기 고려 사회의 변화 모습으로 옳은 것은?", options: ["변발과 호복 등의 몽골풍 유행", "왕실 호칭의 격상", "노비제도의 완벽한 폐지", "경국대전의 반포", "사병의 전면 허용"], answer: 0, explanation: "원 간섭기에는 몽골식 머리 모양(변발)과 옷(호복)이 유행했습니다." },
            { type: "choice", question: "원 간섭기 원나라 세력을 배경으로 대농장을 소유하고 농민을 수탈한 지배 세력은?", options: ["권문세족", "신진사대부", "신흥 무인 세력", "무신 세력", "호족"], answer: 0, explanation: "권문세족은 친원 세력으로 농민의 토지를 빼앗아 대농장을 경작했습니다." },
            { type: "choice", question: "공민왕이 권문세족을 견제하고 불법 토지와 노비 문제를 해결하기 위해 설치한 기구는?", options: ["전민변정도감", "정동행성", "도병마사", "집현전", "홍문관"], answer: 0, explanation: "공민왕은 신돈을 등용하여 전민변정도감을 설치했습니다." },
            { type: "choice", question: "고려 말 성리학을 바탕으로 등장하여 개혁을 추진한 학자 세력은?", options: ["신진사대부", "권문세족", "무신 세력", "진골 귀족", "6두품"], answer: 0, explanation: "신진사대부는 과거를 통해 정계에 진출하여 성리학을 바탕으로 개혁을 주장했습니다." },
            { type: "choice", question: "고려 말 홍건적과 왜구의 침입을 물리치며 백성의 지지를 얻은 세력은?", options: ["신흥 무인 세력", "권문세족", "외척 세력", "문벌 귀족", "환관 세력"], answer: 0, explanation: "최영, 이성계 등의 신흥 무인 세력이 외적 퇴치 과정에서 성숙했습니다." },
            { type: "choice", question: "고려 말 공민왕이 유학 교육을 강화하기 위해 정비한 최고 교육기관은?", options: ["성균관", "태학", "국자감", "서원", "향교"], answer: 0, explanation: "성균관은 고려 말 정비되어 조선시대 최고 유학 교육기관으로 승계되었습니다." },
            { type: "choice", question: "고려 시대 가족제도의 특징으로 옳지 않은 것은?", options: ["아들에게만 재산을 전액 상속했다", "자녀들이 돌아가며 부모 제사를 지냈다", "혼인 후 처가에서 생활하는 경우가 많았다", "여성의 재혼이 비교적 자유로웠다", "딸도 제사를 지낼 수 있었다"], answer: 0, explanation: "고려시대에는 자녀 균등 상속이 이루어졌습니다." },
            { type: "choice", question: "고려 시대 불교 신앙을 바탕으로 형성된 대규모 노동 및 향촌 조직은?", options: ["향도", "계", "두레", "품앗이", "유향소"], answer: 0, explanation: "향도는 불교 신앙에서 출발하여 매향 활동 및 노동 공동체 역할을 했습니다." },
            { type: "choice", question: "몽골의 침입을 부처의 힘으로 막아내고자 강화도에서 제작된 유네스코 세계기록유산은?", options: ["팔만대장경판", "직지심체요절", "조선왕조실록", "무구정광대다라니경", "삼국유사"], answer: 0, explanation: "팔만대장경판은 현재 합천 해인사에 보관되어 있습니다." },
            { type: "choice", question: "1377년 청주 흥덕사에서 금속활자로 인쇄된 세계에서 가장 오래된 금속활자본은?", options: ["직지심체요절", "팔만대장경판", "왕오천축국전", "훈민정음 해례본", "삼국사기"], answer: 0, explanation: "직지심체요절은 세계에서 가장 오래된 금속활자 인쇄본입니다." },
            { type: "choice", question: "조선시대 한양의 유교적 배치 중 토지의 신과 곡식의 신에게 제사를 지내던 시설은?", options: ["사직단", "종묘", "경복궁", "성균관", "훈련원"], answer: 0, explanation: "사직단은 국토와 곡식의 신에게 제사를 지내던 공간입니다." },
            { type: "choice", question: "태조 이성계가 조선이라는 국호를 정할 때 계승하고자 한 고대 국가 이름은?", options: ["고조선", "고구려", "부여", "발해", "통일신라"], answer: 0, explanation: "우리 역사상 최초의 국가인 고조선을 계승한다는 의미를 가집니다." },
            { type: "choice", question: "조선이 명나라에 대해 사대 외교를 실시한 주된 목적으로 가장 적절한 것은?", options: ["국제 정세의 안정과 왕권 정통성 확보", "명나라의 완벽한 영토 점령", "불교 문화의 전파", "호패법의 전국적 시행", "사병 세력의 육성"], answer: 0, explanation: "조선은 명과의 사대 외교를 통해 선진 문물을 수용하고 국제적 안정을 도모했습니다." },
            { type: "choice", question: "조선 세종이 집현전을 설치하고 학자들과 정치를 논의하기 위해 활성화한 제도는?", options: ["경연", "호패법", "6조 직계제", "전민변정도감", "비변사"], answer: 0, explanation: "세종은 경연을 통해 신하들과 토론하며 왕권과 신권의 조화를 꾀했습니다." },
            { type: "choice", question: "조선 태종이 왕권을 강화하고 군사권을 국왕에게 집중시키기 위해 실시한 정책은?", options: ["사병 혁파", "집현전 설치", "홍문관 설치", "경국대전 반포", "의정부 서사제"], answer: 0, explanation: "태종은 개인 군사인 사병을 혁파하여 왕권을 강화했습니다." },
            { type: "choice", question: "조선 세조가 국왕 중심의 통치 체제를 확립하기 위해 시행한 국정 보고 제도는?", options: ["6조 직계제", "의정부 서사제", "경연 제도", "사간원 독립", "암행어사 파견"], answer: 0, explanation: "세조는 6조가 국왕에게 직접 보고하는 6조 직계제를 시행했습니다." },
            { type: "choice", question: "조선 성종 대에 완성되어 반포된 조선의 유교적 통치 법전은?", options: ["경국대전", "속대전", "대전통편", "대전회통", "경세유표"], answer: 0, explanation: "세조 때 착수한 경국대전은 성종 대에 완성되어 완성 반포되었습니다." },
            { type: "choice", question: "조선시대 지방에 파견되어 수령을 감독하고 행정을 총괄하던 관직은?", options: ["관찰사", "향리", "수령", "좌수", "별감"], answer: 0, explanation: "8도에 파견된 관찰사는 수령을 감독하는 역할을 담당했습니다." },
            // 서술형 3문항
            { type: "essay", question: "조선시대 과거 제도 중 관리 선발을 위해 3년마다 정기적으로 실시했던 시험의 명칭을 쓰시오.", answer: "식년시", explanation: "조선의 정기 과거 시험은 3년마다 열리는 식년시입니다." },
            { type: "essay", question: "조선 시대 최고 중앙 정책 결정 기구로 3정승(영의정, 좌의정, 우의정)이 합의하여 정책을 정하던 관청은?", answer: "의정부", explanation: "영의정, 좌의정, 우의정이 속한 조선 최고 국정 심의 기구는 의정부입니다." },
            { type: "essay", question: "조선 세종 시기 이종무가 왜구의 근거지를 토벌하기 위해 공격한 섬의 이름은?", answer: "쓰시마섬 (또는 대마도)", explanation: "세종은 이종무를 파견하여 왜구의 거점인 쓰시마섬을 정벌했습니다." }
        ];

        // 객관식 항목의 보기를 섞어 정답 위치(1~5번)를 무작위 배치
        return rawQuiz.map(q => {
            if (q.type === 'choice') {
                return shuffleOptionsAndFixAnswer(q);
            }
            return q;
        });
    }

    function renderQuiz() {
        const container = document.getElementById('quiz-list');
        container.innerHTML = '';

        generatedQuizData.forEach((q, idx) => {
            const card = document.createElement('div');
            card.className = 'q-card';

            const tagText = q.type === 'choice' ? `[객관식] 주제 ${idx + 1}` : `[서술형] 주제 ${idx + 1}`;
            let html = `<div class="q-tag">${tagText}</div>`;
            html += `<div class="q-title">${idx + 1}. ${q.question}</div>`;

            if (q.type === 'choice') {
                html += `<div class="options">`;
                q.options.forEach((opt, oIdx) => {
                    html += `
                        <label class="option-label">
                            <input type="radio" name="q_${idx}" value="${oIdx}">
                            <span>${oIdx + 1}. ${opt}</span>
                        </label>
                    `;
                });
                html += `</div>`;
            } else {
                html += `
                    <textarea class="essay-input" id="essay_${idx}" placeholder="답안을 서술하세요..."></textarea>
                `;
            }

            html += `
                <div class="explanation" id="exp_${idx}">
                    <strong>정답:</strong> ${q.type === 'choice' ? `${q.answer + 1}번 (${q.options[q.answer]})` : q.answer}<br>
                    <strong>해설:</strong> ${q.explanation}
                </div>
            `;

            card.innerHTML = html;
            container.appendChild(card);
        });
    }

    function gradeQuiz() {
        let correctCount = 0;
        let choiceCount = 0;

        generatedQuizData.forEach((q, idx) => {
            const expBox = document.getElementById(`exp_${idx}`);
            expBox.style.display = 'block';

            if (q.type === 'choice') {
                choiceCount++;
                const selected = document.querySelector(`input[name="q_${idx}"]:checked`);
                if (selected && parseInt(selected.value) === q.answer) {
                    correctCount++;
                }
            }
        });

        const summary = document.getElementById('result-summary');
        summary.innerHTML = `채점 완료!<br>객관식 정답: <span style="color:var(--primary); font-size:1.4rem;">${correctCount} / ${choiceCount}</span> 문제`;

        document.getElementById('result-area').style.display = 'block';
        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    }

    window.onload = generateNewQuiz;
</script>

